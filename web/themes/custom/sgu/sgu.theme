<?php

/**
 * @file
 * Stargate Universe identity.
 */

/**
 * Implements hook_page_attachments_alter().
 *
 * The fonts every page shows first are fetched early.
 */
function sgu_page_attachments_alter(array &$attachments): void {
  $path = base_path() . \Drupal::service('extension.list.theme')->getPath('sgu') . '/fonts/';
  foreach (['barlow-condensed-latin-700-normal', 'barlow-condensed-latin-600-normal', 'barlow-latin-400-normal'] as $font) {
    $attachments['#attached']['html_head_link'][] = [['rel' => 'preload', 'href' => $path . $font . '.woff2', 'as' => 'font', 'type' => 'font/woff2', 'crossorigin' => 'anonymous']];
  }
}
