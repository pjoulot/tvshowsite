<?php

/**
 * @file
 * Hooks for the TV Show core module.
 */

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use GuzzleHttp\Exception\GuzzleException;

/**
 * Implements hook_theme().
 */
function tvshow_core_theme(): array {
  $hooks = [
    // Listings are Views displays; these templates only add the page chrome.
    'tvshow_front' => ['variables' => ['featured' => [], 'news' => [], 'wiki' => [], 'series' => NULL, 'lead' => [], 'more' => [], 'rubrics' => [], 'series_cards' => [], 'news_pages' => 0, 'ad' => '']],
    'tvshow_listing' => ['variables' => ['title' => '', 'kicker' => NULL, 'intro' => NULL, 'layout' => 'news', 'filters' => [], 'content' => [], 'feed_url' => NULL, 'serie_filters' => [], 'letters' => [], 'letter' => NULL, 'count' => NULL, 'breadcrumb' => [], 'aside' => []]],
    'tvshow_listing_header' => ['variables' => ['title' => '', 'kicker' => NULL, 'intro' => NULL, 'filters' => [], 'feed_url' => NULL, 'serie_filters' => [], 'letters' => [], 'letter' => NULL, 'count' => NULL, 'breadcrumb' => []]],
    'tvshow_card' => ['variables' => ['card' => [], 'variant' => 'card']],
    'tvshow_wiki' => ['variables' => ['categories' => [], 'latest' => [], 'title' => 'Wiki', 'rubrics' => []]],
    'tvshow_cast' => ['variables' => ['roles' => [], 'crew' => [], 'has_roles' => TRUE, 'has_crew' => TRUE]],
    'tvshow_partners' => ['variables' => ['partners' => []]],
    'tvshow_search' => ['variables' => ['keys' => '', 'results' => [], 'action' => '']],
    'tvshow_serie' => ['variables' => ['serie' => [], 'seasons' => [], 'season_list' => [], 'show_episodes' => TRUE, 'explore' => [], 'season_cards' => []]],
    'tvshow_not_found' => ['variables' => ['action' => '', 'news' => []]],
    'tvshow_season' => ['variables' => ['season' => [], 'serie' => NULL, 'siblings' => [], 'episodes' => []]],
  ];
  foreach (['article', 'editorial', 'episode', 'people', 'page', 'product'] as $bundle) {
    $hooks['tvshow_node_' . $bundle] = ['variables' => ['data' => []]];
  }
  return $hooks;
}

/**
 * Implements hook_ENTITY_TYPE_view() for nodes.
 *
 * Full pages are rendered by the module's own templates.
 */
function tvshow_core_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, $view_mode): void {
  if ($view_mode !== 'full' || !in_array($node->bundle(), ['article', 'editorial', 'episode', 'people', 'page', 'product'])) {
    return;
  }
  $data = \Drupal::service('tvshow_core.node_page')->build($node);
  $build['tvshow'] = [
    '#theme' => 'tvshow_node_' . $node->bundle(),
    '#data' => $data,
    '#weight' => -100,
  ];
  $build['#cache']['tags'][] = 'node_list';
  $build['#cache']['tags'][] = 'taxonomy_term_list';

  // Description and social sharing tags, unless Metatag provides them.
  if (\Drupal::moduleHandler()->moduleExists('metatag')) {
    return;
  }
  $presenter = \Drupal::service('tvshow_core.presenter');
  $description = trim((string) $node->get('field_meta_description')->value) ?: $presenter->summary($node, $node->bundle() === 'episode' ? 'field_synopsis' : 'body', 160);
  if ($description === '') {
    $description = _tvshow_core_default_description($node);
  }
  $image_field = $node->bundle() === 'people' ? 'field_picture' : 'field_image';
  $image = $presenter->image($node, $image_field, 'tv_wide');
  $tags = [
    ['name' => 'description', 'content' => $description],
    ['property' => 'og:title', 'content' => $node->label()],
    ['property' => 'og:description', 'content' => $description],
    ['property' => 'og:type', 'content' => $node->bundle() === 'article' ? 'article' : 'website'],
    ['property' => 'og:url', 'content' => $node->toUrl('canonical', ['absolute' => TRUE])->toString()],
    ['property' => 'og:site_name', 'content' => \Drupal::config('system.site')->get('name')],
  ];
  $image_url = $image ? $image['src'] : NULL;
  if (!$image_url) {
    // No picture of its own: share the site banner.
    $theme = \Drupal::theme()->getActiveTheme();
    $default = theme_get_setting('header_image_default', $theme->getName());
    $image_url = $default ? base_path() . $theme->getPath() . '/' . ltrim($default, '/') : NULL;
  }
  if ($image_url) {
    $tags[] = ['property' => 'og:image', 'content' => \Drupal::request()->getSchemeAndHttpHost() . $image_url];
    $tags[] = ['name' => 'twitter:card', 'content' => 'summary_large_image'];
  }
  foreach ($tags as $index => $attributes) {
    if ($attributes['content'] !== '' && $attributes['content'] !== NULL) {
      $build['#attached']['html_head'][] = [['#tag' => 'meta', '#attributes' => $attributes], 'tvshow_meta_' . $index];
    }
  }
}

/**
 * Implements hook_entity_insert().
 */
function tvshow_core_entity_insert(EntityInterface $entity): void {
  _tvshow_core_sync_alias($entity);
}

/**
 * Implements hook_entity_update().
 */
function tvshow_core_entity_update(EntityInterface $entity): void {
  _tvshow_core_sync_alias($entity);
}

/**
 * Implements hook_entity_delete().
 */
function tvshow_core_entity_delete(EntityInterface $entity): void {
  if ($entity instanceof ContentEntityInterface && in_array($entity->getEntityTypeId(), ['node', 'taxonomy_term'])) {
    \Drupal::service('tvshow_core.alias_generator')->forget($entity);
  }
}

/**
 * Keeps the generated alias of a node or term up to date.
 */
function _tvshow_core_sync_alias(EntityInterface $entity): void {
  if (!$entity instanceof ContentEntityInterface || !in_array($entity->getEntityTypeId(), ['node', 'taxonomy_term'])) {
    return;
  }
  $generator = \Drupal::service('tvshow_core.alias_generator');
  $generator->sync($entity);
  // Addresses of episodes and seasons contain their parents' names.
  if ($entity->getEntityTypeId() === 'taxonomy_term' && !$entity->isNew() && $entity->getOriginal() && $entity->getOriginal()->label() !== $entity->label()) {
    $repository = \Drupal::service('tvshow_core.repository');
    if ($entity->bundle() === 'serie') {
      foreach ($repository->seasons((int) $entity->id()) as $season) {
        $generator->sync($season);
        foreach ($repository->episodes((int) $season->id()) as $episode) {
          $generator->sync($episode);
        }
      }
    }
    elseif ($entity->bundle() === 'saison') {
      foreach ($repository->episodes((int) $entity->id()) as $episode) {
        $generator->sync($episode);
      }
    }
    elseif ($entity->bundle() === 'category') {
      foreach ($repository->wikiEntries(NULL, ['field_category' => $entity->id()], 'title') as $entry) {
        $generator->sync($entry);
      }
    }
  }
}

/**
 * Implements hook_cron().
 *
 * Hides partners whose site no longer answers and shows them again when it
 * comes back. A partner is only hidden after three failed checks in a row.
 */
function tvshow_core_cron(): void {
  $state = \Drupal::state();
  if (\Drupal::time()->getRequestTime() - (int) $state->get('tvshow_core.partners_checked', 0) < 86400) {
    return;
  }
  $state->set('tvshow_core.partners_checked', \Drupal::time()->getRequestTime());
  $failures = $state->get('tvshow_core.partner_failures', []);
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('vid', 'partenaires')->execute();
  foreach ($storage->loadMultiple($ids) as $term) {
    $link = $term->get('field_url')->first();
    if (!$link) {
      continue;
    }
    $ok = FALSE;
    try {
      $response = \Drupal::httpClient()->get($link->getUrl()->toString(), ['timeout' => 10, 'http_errors' => FALSE, 'headers' => ['Accept' => 'text/html']]);
      $ok = $response->getStatusCode() < 400;
    }
    catch (GuzzleException $e) {
      $ok = FALSE;
    }
    $failures[$term->id()] = $ok ? 0 : ($failures[$term->id()] ?? 0) + 1;
    if ($ok && !$term->isPublished()) {
      $term->setPublished()->save();
    }
    elseif (!$ok && $failures[$term->id()] >= 3 && $term->isPublished()) {
      $term->setUnpublished()->save();
      \Drupal::logger('tvshow_core')->notice('Partner %name hidden: its site did not answer three checks in a row.', ['%name' => $term->label()]);
    }
  }
  $state->set('tvshow_core.partner_failures', $failures);
}

/**
 * Implements hook_form_FORM_ID_alter() for the site contact form.
 *
 * Visitor-facing labels are French even before interface translations are
 * installed.
 */
function tvshow_core_form_contact_message_feedback_form_alter(array &$form, FormStateInterface $form_state): void {
  $labels = ['name' => 'Votre nom', 'mail' => 'Votre adresse e-mail', 'subject' => 'Sujet', 'message' => 'Message', 'copy' => 'M’envoyer une copie'];
  foreach ($labels as $key => $label) {
    if (isset($form[$key]['widget'][0]['value'])) {
      $form[$key]['widget'][0]['value']['#title'] = $label;
    }
    elseif (isset($form[$key])) {
      $form[$key]['#title'] = $label;
    }
  }
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = 'Envoyer le message';
  }
  if (isset($form['actions']['preview'])) {
    $form['actions']['preview']['#access'] = FALSE;
  }
}

/**
 * View modes Views rows are rendered in, and the card each one prints.
 */
const TVSHOW_CORE_CARD_MODES = ['card', 'row', 'line', 'feature', 'role'];

/**
 * Implements hook_ENTITY_TYPE_view_alter() for nodes.
 *
 * Listing rows (the "card" family of view modes) are printed by the module's
 * card template, so every listing shares one markup per content type.
 */
function tvshow_core_node_view_alter(array &$build, NodeInterface $node, EntityViewDisplayInterface $display): void {
  $mode = $build['#view_mode'] ?? 'full';
  if ($mode === 'rss') {
    // Feed items carry a plain-text summary.
    foreach (Element::children($build) as $key) {
      unset($build[$key]);
    }
    $build['summary'] = ['#plain_text' => \Drupal::service('tvshow_core.presenter')->summary($node, $node->bundle() === 'episode' ? 'field_synopsis' : 'body', 400)];
    return;
  }
  if (!in_array($mode, TVSHOW_CORE_CARD_MODES, TRUE)) {
    return;
  }
  $presenter = \Drupal::service('tvshow_core.presenter');
  foreach (Element::children($build) as $key) {
    unset($build[$key]);
  }
  $build['#theme'] = 'tvshow_card';
  $build['#card'] = $mode === 'role' ? $presenter->roleCard($node) : $presenter->card($node);
  $build['#variant'] = $mode;
  unset($build['#contextual_links']);
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for taxonomy terms.
 */
function tvshow_core_taxonomy_term_view_alter(array &$build, TermInterface $term, EntityViewDisplayInterface $display): void {
  if (($build['#view_mode'] ?? 'full') !== 'card') {
    return;
  }
  $repository = \Drupal::service('tvshow_core.repository');
  $count = match ($term->bundle()) {
    'saison' => $repository->countEpisodes((int) $term->id()),
    'category' => $repository->countWikiEntries((int) $term->id()),
    default => NULL,
  };
  foreach (Element::children($build) as $key) {
    unset($build[$key]);
  }
  $build['#cache']['tags'][] = 'node_list';
  if ($term->bundle() === 'category' && !$count) {
    // A wiki rubric without entries is not listed.
    $build['#access'] = FALSE;
    return;
  }
  $build['#theme'] = 'tvshow_card';
  $build['#card'] = \Drupal::service('tvshow_core.presenter')->termCard($term, $count);
  $build['#variant'] = 'card';
  $build['#cache']['tags'][] = 'node_list';
  unset($build['#contextual_links']);
}

/**
 * Implements hook_views_data().
 */
function tvshow_core_views_data(): array {
  $data['views']['tvshow_page_header'] = [
    'title' => t('TV Show page header'),
    'help' => t('Breadcrumb, page title, optional rubric links and feed link, in the site design.'),
    'area' => ['id' => 'tvshow_page_header'],
  ];
  return $data;
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Embedded listings get their keywords from the page's own search form.
 */
function tvshow_core_preprocess_views_view(array &$variables): void {
  if ($variables['view']->getDisplay()->getPluginId() === 'embed' && $variables['view']->storage->get('tag') === 'tvshow') {
    $variables['exposed'] = [];
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Every page gets a description, a canonical address and sharing tags.
 * Whatever Metatag or the node pages already provide is left alone; this only
 * fills what is missing (listings, the front page, term pages, content without
 * a hand-written description).
 */
function tvshow_core_page_attachments_alter(array &$attachments): void {
  $route_match = \Drupal::routeMatch();
  $route = (string) $route_match->getRouteName();
  if (\Drupal::service('router.admin_context')->isAdminRoute() || $route === '') {
    return;
  }
  $metatag = \Drupal::moduleHandler()->moduleExists('metatag');
  $node = $route_match->getParameter('node');
  $node = $node instanceof NodeInterface && $route === 'entity.node.canonical' ? $node : NULL;
  if ($node && !$metatag) {
    // tvshow_core_node_view() writes the whole set.
    return;
  }

  // What is already there.
  $have = [];
  foreach ($attachments['#attached']['html_head'] ?? [] as $item) {
    $attributes = $item[0]['#attributes'] ?? [];
    $key = $attributes['name'] ?? $attributes['property'] ?? (($attributes['rel'] ?? '') === 'canonical' ? 'canonical' : NULL);
    if ($key && trim((string) ($attributes['content'] ?? $attributes['href'] ?? '')) !== '') {
      $have[$key] = TRUE;
    }
  }
  foreach ($attachments['#attached']['html_head_link'] ?? [] as $item) {
    if (($item[0]['rel'] ?? '') === 'canonical') {
      $have['canonical'] = TRUE;
    }
  }

  $presenter = \Drupal::service('tvshow_core.presenter');
  $site = \Drupal::config('system.site');
  $settings = \Drupal::config('tvshow_core.settings');
  $name = (string) $site->get('name');
  $tagline = trim((string) ($settings->get('tagline') ?: $site->get('slogan')));
  $request = \Drupal::request();
  $is_front = \Drupal::service('path.matcher')->isFrontPage();
  $title = $is_front ? $name : (string) \Drupal::service('title_resolver')->getTitle($request, $route_match->getRouteObject());
  $title = trim(strip_tags($title)) ?: $name;
  $image = NULL;
  $term = $route_match->getParameter('taxonomy_term');

  if ($node) {
    $description = trim((string) $node->get('field_meta_description')->value) ?: $presenter->summary($node, $node->bundle() === 'episode' ? 'field_synopsis' : 'body', 160);
    $description = $description ?: _tvshow_core_default_description($node);
    $image = $presenter->image($node, $node->bundle() === 'people' ? 'field_picture' : 'field_image', 'tv_wide');
    $title = $node->label();
  }
  elseif ($term instanceof TermInterface) {
    $title = $term->label();
    $description = $presenter->summary($term, 'description', 160);
    $image = $presenter->image($term, 'field_image', 'tv_wide');
  }
  elseif ($is_front) {
    $description = trim((string) $settings->get('description')) ?: $name . ($tagline ? ' – ' . $tagline : '') . ' : actualités, guide des épisodes, wiki et casting.';
  }
  else {
    $description = match ($route) {
      'view.tvshow_news.page' => "Toutes les actualités de $name : diffusion, audiences, interviews, vidéos et photos.",
      'tvshow_core.episodes' => "Le guide des épisodes de $name : saisons, résumés, dates de diffusion, réalisateurs et scénaristes.",
      'tvshow_core.wiki' => "Le wiki de $name : les personnages et l’univers de la série, fiche par fiche.",
      'tvshow_core.cast' => "Le casting de $name : les personnages, leurs interprètes et l’équipe de la série.",
      'view.tvshow_people.page' => "Acteurs, réalisateurs et scénaristes de $name : toutes les personnalités de la série.",
      'tvshow_core.partners' => "Les sites partenaires de $name.",
      default => '',
    };
  }
  if (trim($description) === '') {
    $description = $title . ' – ' . $name . ($tagline ? ', ' . mb_strtolower(mb_substr($tagline, 0, 1)) . mb_substr($tagline, 1) : '') . '.';
  }
  $page = (int) $request->query->get('page', 0);
  if ($page > 0) {
    $description = rtrim($description, '.') . ' – page ' . ($page + 1) . '.';
  }

  // The address without tracking parameters: only the page number and the
  // search keywords are part of what the page shows.
  $query = array_intersect_key($request->query->all(), ['page' => 1, 's' => 1]);
  $canonical = $is_front && !$query
    ? \Drupal\Core\Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString()
    : \Drupal\Core\Url::fromRoute('<current>', [], ['absolute' => TRUE, 'query' => $query])->toString();

  if (!$image) {
    // No picture of its own: share the site banner.
    $theme = \Drupal::theme()->getActiveTheme();
    $default = theme_get_setting('header_image_default', $theme->getName());
    $image_url = $default ? $request->getSchemeAndHttpHost() . base_path() . $theme->getPath() . '/' . ltrim($default, '/') : NULL;
  }
  else {
    $image_url = $request->getSchemeAndHttpHost() . $image['src'];
  }

  $tags = [
    'description' => ['name' => 'description', 'content' => $description],
    'og:title' => ['property' => 'og:title', 'content' => $title],
    'og:description' => ['property' => 'og:description', 'content' => $description],
    'og:type' => ['property' => 'og:type', 'content' => $node && $node->bundle() === 'article' ? 'article' : 'website'],
    'og:url' => ['property' => 'og:url', 'content' => $canonical],
    'og:site_name' => ['property' => 'og:site_name', 'content' => $name],
    'og:image' => ['property' => 'og:image', 'content' => $image_url],
    'twitter:card' => ['name' => 'twitter:card', 'content' => $image_url ? 'summary_large_image' : 'summary'],
  ];
  foreach ($tags as $key => $attributes) {
    if (empty($have[$key]) && trim((string) $attributes['content']) !== '') {
      $attachments['#attached']['html_head'][] = [['#tag' => 'meta', '#attributes' => $attributes], 'tvshow_fallback_' . strtr($key, ':', '_')];
    }
  }
  // Entity pages get their canonical link from core or Metatag.
  if (empty($have['canonical']) && !$node && !($metatag && $term)) {
    $attachments['#attached']['html_head_link'][] = [['rel' => 'canonical', 'href' => $canonical]];
  }
  $attachments['#cache']['contexts'][] = 'url';
  $attachments['#cache']['tags'][] = 'config:tvshow_core.settings';
  $attachments['#cache']['tags'][] = 'config:system.site';
}

/**
 * A one-line description for content that has no text yet.
 */
function _tvshow_core_default_description(NodeInterface $node): string {
  $presenter = \Drupal::service('tvshow_core.presenter');
  $site = (string) \Drupal::config('system.site')->get('name');
  $card = $presenter->card($node);
  switch ($node->bundle()) {
    case 'episode':
      $text = $node->label();
      if (!empty($card['original_title']) && $card['original_title'] !== $node->label()) {
        $text .= ' (' . $card['original_title'] . ')';
      }
      $text .= ' : épisode ' . $card['number'] . (!empty($card['season']) ? ' de la ' . mb_strtolower($card['season']['name']) : '');
      $season = $node->get('field_season')->entity;
      $serie = $season && $season->hasField('field_serie') ? $season->get('field_serie')->entity : NULL;
      $text .= ' de ' . ($serie ? $serie->label() : $site);
      return $text . (!empty($card['date']) ? ', diffusé le ' . $card['date'] : '') . '.';

    case 'people':
      $jobs = array_map(fn($job) => mb_strtolower($job['name']), $card['jobs'] ?? []);
      return $node->label() . ($jobs ? ', ' . implode(' et ', $jobs) : '') . ' – ' . $site . ' : sa fiche et les épisodes auxquels il ou elle a participé.';

    default:
      return $node->label() . ' – ' . $site . '.';
  }
}
