{# Cast page. roles and crew are Views displays. #}
{% import '@tvshow_core/partials/ui.html.twig' as ui %}
<div class="tv-page tv-cast">
  {{ ui.breadcrumb([], 'Casting') }}
  <header class="tv-pagehead">{{ ui.heading('Casting', null, null, 1) }}</header>
  {{ roles }}
  {% if has_crew %}
    <section class="tv-section">
      {{ ui.heading('Le reste de l’équipe', path('view.tvshow_people.page'), 'Toutes les personnalités') }}
      {{ crew }}
    </section>
  {% endif %}
</div>
