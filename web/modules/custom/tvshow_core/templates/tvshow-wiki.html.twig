{# Wiki home. categories and latest are Views displays. #}
{% import '@tvshow_core/partials/ui.html.twig' as ui %}
<div class="tv-page tv-wiki">
  {{ ui.breadcrumb([], 'Wiki') }}
  <header class="tv-pagehead">{{ ui.heading('Wiki', null, null, 1) }}</header>
  {{ categories }}
  <section class="tv-section">
    {{ ui.heading('Dernières fiches') }}
    {{ latest }}
  </section>
</div>
