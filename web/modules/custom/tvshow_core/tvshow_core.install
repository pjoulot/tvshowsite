<?php

/**
 * @file
 * Install hooks for the TV Show core module.
 */

use Drupal\menu_link_content\Entity\MenuLinkContent;

/**
 * Implements hook_install().
 */
function tvshow_core_install($is_syncing): void {
  if ($is_syncing) {
    return;
  }
  \Drupal::configFactory()->getEditable('system.site')->set('page.front', '/accueil')->save();

  // Visitors may read the site and use the contact form.
  if (\Drupal::moduleHandler()->moduleExists('contact')) {
    user_role_grant_permissions('anonymous', ['access site-wide contact form']);
    user_role_grant_permissions('authenticated', ['access site-wide contact form']);
    $mail = \Drupal::config('system.site')->get('mail') ?: 'admin@example.com';
    $forms = \Drupal::entityTypeManager()->getStorage('contact_form');
    if (!$forms->load('feedback')) {
      $forms->create(['id' => 'feedback', 'label' => 'Contact', 'recipients' => [$mail], 'reply' => '', 'weight' => 0])->save();
    }
    \Drupal::configFactory()->getEditable('contact.settings')->set('default_form', 'feedback')->save();
  }

  // French is the site language. Interface translations are fetched later by
  // the locale module, if it is enabled.
  if (\Drupal::moduleHandler()->moduleExists('language')) {
    if (!\Drupal\language\Entity\ConfigurableLanguage::load('fr')) {
      \Drupal\language\Entity\ConfigurableLanguage::createFromLangcode('fr')->save();
    }
    \Drupal::configFactory()->getEditable('system.site')->set('default_langcode', 'fr')->save();
    // One language, so no /fr prefix in addresses.
    \Drupal::configFactory()->getEditable('language.negotiation')->set('url.prefixes.fr', '')->set('url.prefixes.en', 'en')->save();
  }
  \Drupal::configFactory()->getEditable('system.site')->set('page.404', '/introuvable')->save();
  // The news feed is /actualites/rss.xml; core's /rss.xml would be a second one.
  if (\Drupal::moduleHandler()->moduleExists('views') && ($frontpage = \Drupal\views\Entity\View::load('frontpage'))) {
    $frontpage->disable()->save();
  }
  // Listings embedded in pages are "embed" displays: let the Views UI add them.
  \Drupal::configFactory()->getEditable('views.settings')->set('ui.show.display_embed', TRUE)->save();
  // Accounts are for the editorial team only.
  \Drupal::configFactory()->getEditable('user.settings')->set('register', 'admin_only')->save();
  \Drupal::configFactory()->getEditable('system.date')->set('country.default', 'FR')->set('timezone.default', 'Europe/Paris')->save();

  $main = [
    'Accueil' => 'internal:/',
    'Actualités' => 'internal:/actualites',
    'Épisodes' => 'internal:/episodes',
    'Casting' => 'internal:/casting',
    'Wiki' => 'internal:/wiki',
    'Partenaires' => 'internal:/partenaires',
    'Contact' => 'internal:/contact',
  ];
  $weight = 0;
  foreach ($main as $title => $uri) {
    MenuLinkContent::create(['title' => $title, 'link' => ['uri' => $uri], 'menu_name' => 'main', 'weight' => $weight++])->save();
  }
  $footer = [
    'Flux RSS' => 'internal:/actualites/rss.xml',
    'Partenaires' => 'internal:/partenaires',
    'Contact' => 'internal:/contact',
  ];
  $weight = 0;
  foreach ($footer as $title => $uri) {
    MenuLinkContent::create(['title' => $title, 'link' => ['uri' => $uri], 'menu_name' => 'footer', 'weight' => $weight++])->save();
  }
}

/**
 * Products, facts, first appearances, series of people and listing filters.
 *
 * Adds the "Produit dérivé" content type and the "Type de produit"
 * vocabulary, the fields added since the first release, the product listing
 * and the new displays and filters of the news, wiki and people listings.
 * The news, wiki and people views are replaced by the module's versions.
 */
function tvshow_core_update_11001(): string {
  $source = new \Drupal\Core\Config\FileStorage(\Drupal::service('extension.list.module')->getPath('tvshow_core') . '/config/install');
  $manager = \Drupal::entityTypeManager();
  $config_manager = \Drupal::service('config.manager');
  $order = ['taxonomy.vocabulary.', 'node.type.', 'field.storage.', 'field.field.', 'core.entity_form_display.', 'core.entity_view_display.', 'views.view.'];
  $replace = ['views.view.tvshow_news', 'views.view.tvshow_wiki', 'views.view.tvshow_people'];
  $done = [];
  foreach ($order as $prefix) {
    foreach ($source->listAll($prefix) as $name) {
      $exists = (bool) \Drupal::configFactory()->get($name)->getRawData();
      if ($exists && !in_array($name, $replace, TRUE)) {
        continue;
      }
      $entity_type = $config_manager->getEntityTypeIdByName($name);
      if (!$entity_type) {
        continue;
      }
      $storage = $manager->getStorage($entity_type);
      $record = $source->read($name);
      if ($exists) {
        $entity = $storage->load($storage->getIDFromConfigName($name, $storage->getEntityType()->getConfigPrefix()));
        $entity = $storage->updateFromStorageRecord($entity, $record);
      }
      else {
        $entity = $storage->createFromStorageRecord($record);
      }
      $entity->save();
      $done[] = $name;
    }
  }
  // New fields of existing content types appear in their edit forms.
  $repository = \Drupal::service('entity_display.repository');
  $new_fields = [
    'node' => ['editorial' => ['field_facts' => 'string_textarea', 'field_appearance' => 'entity_reference_autocomplete_tags'], 'episode' => ['field_facts' => 'string_textarea'], 'people' => ['field_facts' => 'string_textarea', 'field_series' => 'options_buttons']],
    'taxonomy_term' => ['serie' => ['field_facts' => 'string_textarea']],
  ];
  foreach ($new_fields as $entity_type => $bundles) {
    foreach ($bundles as $bundle => $widgets) {
      $form = $repository->getFormDisplay($entity_type, $bundle);
      foreach ($widgets as $field => $widget) {
        if (!$form->getComponent($field)) {
          $form->setComponent($field, ['type' => $widget, 'weight' => 50]);
        }
      }
      $form->save();
    }
  }
  if ($frontpage = \Drupal\views\Entity\View::load('frontpage')) {
    $frontpage->disable()->save();
  }
  $settings = \Drupal::configFactory()->getEditable('tvshow_core.settings');
  foreach (['wiki_path' => 'wiki', 'wiki_label' => 'Wiki', 'ad_html' => '', 'social.steam' => NULL] as $key => $default) {
    if ($settings->get($key) === NULL && $default !== NULL) {
      $settings->set($key, $default);
    }
  }
  $settings->save();
  if (\Drupal::moduleHandler()->moduleExists('user') && ($role = \Drupal\user\Entity\Role::load('editor'))) {
    foreach (['create product content', 'edit any product content', 'delete own product content', 'view product revisions'] as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
  return 'Created or updated: ' . implode(', ', $done);
}
