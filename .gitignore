# Installed by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/
/recipes/

# Scaffold files written by drupal/core-composer-scaffold
/web/.csslintrc
/web/.editorconfig
/web/.eslintignore
/web/.eslintrc.json
/web/.gitattributes
/web/.htaccess
/web/.ht.router.php
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/autoload_runtime.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/sites/*.php
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/default/default.*
/web/modules/README.txt
/web/themes/README.txt
/web/profiles/README.txt

# Site data and secrets
/web/sites/*/settings*.php
/web/sites/*/services*.yml
/web/sites/*/files/
/web/sites/simpletest/
/.env

# Old-site archives used by the content import
/content/*/archive/

# Local tooling
/.ddev/*
!/.ddev/config.yaml
/.idea/
/composer.workspace.json
/composer.workspace.lock

# Wayback extras: page snapshots and the hand-over archive stay local
/content/*/wayback/html/
/content/*/wayback.tar.gz

# Episode photo sets fetched by scripts/fetch_gateworld_promos.sh (large)
/content/*/gateworld/
